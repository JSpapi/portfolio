# --- Database ---
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# --- Admin seed credentials ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password

# --- JWT ---
JWT_SECRET=replace-with-32-byte-random-string
JWT_EXPIRY=72h

# --- Cloudflare R2 (optional in dev; media upload disabled if unset) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=portfolio-media
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# --- App ---
APP_BASE_URL=http://localhost:3000
PORT=8080

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Set to 1 for local http so cookies work without HTTPS
COOKIE_INSECURE=1

# --- Next.js ISR revalidation ---
REVALIDATE_SECRET=another-random-string

# --- Telegram Bot (gated-page approvals) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=random-webhook-path-secret

# --- Transactional email (magic-link delivery) — Resend ---
# If RESEND_API_KEY is empty, the magic link is printed to the server log instead.
RESEND_API_KEY=
EMAIL_FROM=Axror <access@yourdomain.com>

# --- Gated-page access sessions ---
ACCESS_MAGIC_EXPIRY=24h
ACCESS_SESSION_EXPIRY=720h
ACCESS_RATE_LIMIT_PER_HOUR=3
